import nltk
from nltk import PCFG
from nltk.parse import ViterbiParser

# Define a Probabilistic Context-Free Grammar
grammar = PCFG.fromstring("""
    S -> NP VP [1.0]

    NP -> Det N [0.6]
    NP -> Det Adj N [0.4]

    VP -> V NP [0.7]
    VP -> V [0.3]

    Det -> 'the' [0.6]
    Det -> 'a' [0.4]

    Adj -> 'small' [0.5]
    Adj -> 'big' [0.5]

    N -> 'boy' [0.4]
    N -> 'girl' [0.3]
    N -> 'dog' [0.3]

    V -> 'sees' [0.5]
    V -> 'runs' [0.5]
""")

# Create the Viterbi parser
parser = ViterbiParser(grammar)

# Input sentence
sentence = "the boy sees a dog"

# Tokenize the sentence
tokens = sentence.split()

# Generate the most probable parse tree
print("Sentence:", sentence)
print("\nMost Probable Parse Tree:\n")

for tree in parser.parse(tokens):
    print(tree)
    print("\nProbability:", tree.prob())
    tree.pretty_print()
