from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

# Collection of documents
documents = [
    "Machine learning is a branch of artificial intelligence",
    "Artificial intelligence is used in machine learning",
    "Python is a popular programming language",
    "Machine learning algorithms are used for data analysis",
    "Data science uses Python for machine learning"
]

# Create TF-IDF vectorizer
vectorizer = TfidfVectorizer()

# Convert documents into TF-IDF vectors
tfidf_matrix = vectorizer.fit_transform(documents)

# User query
query = "machine learning"

# Convert query into TF-IDF vector
query_vector = vectorizer.transform([query])

# Calculate cosine similarity between query and documents
similarity_scores = cosine_similarity(query_vector, tfidf_matrix)[0]

# Rank documents according to similarity score
ranked_documents = sorted(
    enumerate(similarity_scores),
    key=lambda x: x[1],
    reverse=True
)

# Display ranked results
print("Query:", query)
print("\nDocument Ranking:")

for rank, (index, score) in enumerate(ranked_documents, start=1):
    print(f"Rank {rank}: Document {index + 1}")
    print(f"Score: {score:.4f}")
    print(f"Text: {documents[index]}\n")
